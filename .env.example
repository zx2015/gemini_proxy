# =====================================================================
# gemini_proxy — 环境变量模板
# 复制为 .env 后填入实际值；.env 严禁提交至 Git
# =====================================================================

# ---- 上游 OpenAI 兼容服务（必填）----
UPSTREAM_OPENAI_URL=http://localhost:4000
UPSTREAM_API_KEY=sk-empty
UPSTREAM_MODEL=gpt-4o
# v0.1.0-r1 起：忽略客户端 model，强制使用此值。
# 常用：MiniMax/MiniMax-M3、Gemini/Gemini-2.5-Flash、Gemini/Gemini-3.1-Pro 等

# ---- 网关入站鉴权（必填）----
PROXY_API_KEY=your-secret-proxy-key

# ---- 监听（可选）----
HOST=0.0.0.0
PORT=8000

# ---- 日志（可选）----
LOG_LEVEL=INFO

# ---- HTTP 行为（可选）----
REQUEST_TIMEOUT=600
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1.0
# 流式超时（参考 cc-switch 的三段式超时设计）：
#   STREAM_FIRST_BYTE_TIMEOUT: 从发出请求到首个 SSE chunk 到达的最大等待时间（秒），0=不限制
#   STREAM_IDLE_TIMEOUT:       相邻两个 SSE chunk 之间的最大静默时间（秒），0=不限制
# 当 LiteLLM/MiniMax 上游流式挂起时，idle timeout 会主动终止并下发 DEADLINE_EXCEEDED 错误帧。
STREAM_FIRST_BYTE_TIMEOUT=60
STREAM_IDLE_TIMEOUT=120

# ---- 模型发现（可选）----
MODEL_DISCOVERY_CACHE_TTL=300

# ---- MiniMax 兼容恢复（可选）----
# 当上游把 tool_call 泄漏到 content 文本（MiniMax M3 命名空间标记）时，
# 自动恢复为结构化工具调用，并清理泄漏文本。
MINIMAX_TOOL_MARKUP_RECOVERY=true

# ---- 熔断器（可选）----
# 连续上游可重试失败（5xx / 网络错误 / 流式超时）达到 CB_FAILURE_THRESHOLD 次后，
# 熔断器进入 OPEN 状态，后续请求立即返回 503，不再打到上游。
# OPEN 状态持续 CB_RECOVERY_TIMEOUT 秒后进入 HALF_OPEN，放行最多 CB_HALF_OPEN_MAX_CALLS 个探针请求：
#   探针成功 → CLOSED（恢复正常）；探针失败 → OPEN（重新计时）
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT=60
CB_HALF_OPEN_MAX_CALLS=1
